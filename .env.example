# Copy to .env and fill in. .env is ignored by git.

# Admin password for the database container (SYS, SYSTEM, PDBADMIN). Used only by compose.yaml.
ORACLE_PWD=change-me-admin
# Application user created in FREEPDB1 on first start.
DB_USER=ccctx
# Application user password. Never printed by any script.
DB_PASSWORD=change-me-app
# Database host. Default localhost.
DB_HOST=localhost
# Database port, also the host port compose.yaml publishes. Default 1521.
DB_PORT=1521
# Pluggable database service name. Default FREEPDB1.
DB_SERVICE=FREEPDB1
# Where sample repositories are cloned, relative to the project root. Must be outside the project.
CCCTX_REPOS_DIR=../ccctx-repos
